# Telegram Mini App Configuration
# Copy this file to .env and fill in your actual values

# Your Telegram Bot Token
# Get this from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Telegram Account ID (Owner)
# Get this from @userinfobot on Telegram
OWNER_TELEGRAM_ID=YOUR_OWNER_TELEGRAM_ID_HERE

# Your Mini App URL (must be HTTPS)
MINI_APP_URL=https://your-domain.com/mini-app

# Backend API Base URL
API_BASE_URL=https://your-api.com/api

# Telegram API Configuration
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH

# Enable mock authentication for testing
# Set to false for production with real Telegram authentication
ENABLE_MOCK_AUTH=false

# Test credentials (for development only)
TEST_CODE=12345
TEST_PASSWORD=password123

# Environment
# Options: development, staging, production
NODE_ENV=production

# Logging level
# Options: debug, info, warn, error
LOG_LEVEL=info

# Authentication Settings
SESSION_TIMEOUT=600
MAX_LOGIN_ATTEMPTS=5
CODE_VALIDITY_DURATION=120
VERIFICATION_CODE_LENGTH=5
